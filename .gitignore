# ── Dependencias ─────────────────────────────────────────────
/node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
.npm-cache/

# ── Next.js (compilados y caché) ─────────────────────────────
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo
.turbo

# ── Sanity (Studio compilado y caché local) ──────────────────
/dist
.sanity/

# ── Variables de entorno: contienen tokens y claves ──────────
# Se ignoran todas; solo se permite subir una plantilla sin datos reales.
.env*
!.env.example

# ── Despliegue ───────────────────────────────────────────────
.vercel
*.pem

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dev.log
next-dev*.log

# ── Pruebas ──────────────────────────────────────────────────
/coverage

# ── Sistema operativo ────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editores ─────────────────────────────────────────────────
.idea/
*.swp

# ── Ajustes locales de Claude Code ───────────────────────────
# Los compartidos van en .claude/settings.json
.claude/settings.local.json

# ── Scripts temporales de un solo uso ────────────────────────
scripts/_*
